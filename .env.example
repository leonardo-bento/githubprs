# Token is read by the server; it is not sent to the browser.
GITHUB_PAT=ghp_***
GITHUB_USERS=your-user,somebody-user
GITHUB_GROUPS=group-a,group-b
GITHUB_ORGANIZATION=your-org
# Optional: additional automation usernames to exclude from approval/comment counts.
# GitHub Bot accounts are excluded automatically. Match usernames, not display names.
GITHUB_BOT_USERS=
# Optional: defaults to ./data
# PR_DATA_DIR=/absolute/path/to/data
